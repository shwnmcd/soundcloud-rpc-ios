{
  "name": "soundcloud-s",
  "version": "3.1.0",
  "description": "SoundCloud S — ad-free SoundCloud desktop client with Discord Rich Presence, Group Jam & multiplayer games. Based on SoundCloud RPC by richardhbtz.",
  "main": "src/main.js",
  "author": "SoundCloud S (based on SoundCloud RPC by richardhbtz)",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64",
    "build:win-portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "hls.js": "^1.5.17"
  },
  "devDependencies": {
    "electron": "^32.2.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.soundclouds.desktop",
    "productName": "SoundCloud S",
    "copyright": "SoundCloud S · Based on SoundCloud RPC by richardhbtz (MIT)",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "SoundCloud S Jam",
        "schemes": [
          "soundcloudrpc"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SoundCloud S",
      "uninstallDisplayName": "SoundCloud S",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "license": "build/license.txt",
      "artifactName": "SoundCloud-S-Setup.exe"
    },
    "portable": {
      "artifactName": "SoundCloud-S-Portable.exe"
    }
  }
}
